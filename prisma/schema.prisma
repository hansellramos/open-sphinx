// Bóveda: videos cifrados. El servidor nunca tiene la clave para descifrar; solo la pública para cifrar.
generator client {
  provider = "prisma-client"
  output   = "../server/generated/prisma"
}

datasource db {
  provider = "sqlite"
}

// ---------------- NÚCLEO (adaptado de AirCore: sesión, sin usuarios/perfiles porque es personal) ----------------

model Session {
  sid       String   @id
  data      String
  expiresAt DateTime
}

// Passkeys registradas. prfWrap = la clave privada de la bóveda cifrada con el secreto PRF de esta passkey.
model Credential {
  id         String    @id // credential id (base64url)
  publicKey  Bytes
  counter    Int       @default(0)
  transports String? // JSON
  name       String
  prfWrap    String? // JSON {salt, iv, ct}
  createdAt  DateTime  @default(now())
  lastUsedAt DateTime?
}

// Una sola bóveda: clave pública X25519 + la privada envuelta con el código de recuperación.
model Vault {
  id           Int      @id @default(1)
  publicKey    String // base64url raw X25519
  recoveryWrap String // JSON {salt, iv, ct}
  metaKeyWrap  String? // JSON {epk, iv, ct}: clave de metadatos de la bóveda, sellada con la pública
  catalog      String? // catálogo cifrado con la clave de metadatos (etiquetas, colores…)
  createdAt    DateTime @default(now())
}

// ---------------- VIDEOS ----------------

// Todo lo descriptivo (título, fecha, ubicación, etiquetas, favorito…) va en `meta`, cifrado con la
// clave del video. Las columnas marcadas "legado" son del MVP (sin cifrar) y se vacían al migrar.
model Video {
  id           String    @id @default(uuid())
  meta         String? // base64url [iv][ct] — JSON cifrado con la clave del video
  title        String? // legado
  originalName String? // legado
  mime         String? // legado
  size         Int       @default(0)
  uploadId     String?   @unique // id de la subida tus (archivo temporal sin cifrar)
  status       String    @default("en_cola") // en_cola | procesando | listo | error
  error        String?
  duration     Float? // legado
  width        Int? // legado
  height       Int? // legado
  videoCodec   String? // legado
  segments     Int?
  keyWrap      String? // JSON {epk, iv, ct}: clave del video sellada con la clave pública
  extra        String? // JSON sellado por el navegador al subir (etiquetas); el worker lo mete en meta y lo borra
  reducir      Int? // elegido al subir: al procesarlo se crea una versión con este lado corto (720, 540) que lo reemplaza
  createdAt    DateTime  @default(now())
  readyAt      DateTime?
  jobs         Job[]
  exportaciones Exportacion[]
  tags         Tag[] // legado
}

// Legado (MVP sin cifrar): se migra al catálogo cifrado y se borra.
model Tag {
  id        Int      @id @default(autoincrement())
  name      String   @unique
  color     String   @default("primary")
  createdAt DateTime @default(now())
  videos    Video[]
}

model Job {
  id         Int       @id @default(autoincrement())
  type       String // procesar
  videoId    String
  video      Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  status     String    @default("pendiente") // pendiente | corriendo | hecho | error
  attempts   Int       @default(0)
  error      String?
  createdAt  DateTime  @default(now())
  startedAt  DateTime?
  finishedAt DateTime?

  @@index([status, createdAt])
}

// Exportación de un video (más pequeño y/o con filtro), a pedido y por 7 días. `clave` es la del video prestada
// por el navegador: solo existe mientras está en cola; el worker la borra al tomar el trabajo.
model Exportacion {
  id        String    @id @default(uuid())
  videoId   String
  video     Video     @relation(fields: [videoId], references: [id], onDelete: Cascade)
  alto      Int? // lado corto pedido (720, 480); null = tamaño original
  filtro    String? // a | b | c (posterizado); null = sin filtro
  status    String    @default("en_cola") // en_cola | procesando | lista | error
  error     String?
  clave     String?
  duracion  Float?
  progreso  Int       @default(0)
  size      Int       @default(0)
  estimado  Int? // peso final estimado mientras se crea (por lo que pesan los fragmentos ya hechos)
  reemplazar Boolean  @default(false) // pedida al subir: al terminar reemplaza al original (si pesa menos)
  createdAt DateTime  @default(now())
  readyAt   DateTime?
  expiresAt DateTime?

  @@index([videoId])
  @@index([status, createdAt])
}

// Lo que pesaron las exportaciones terminadas, por filtro, para estimar las próximas antes de pedirlas:
// bytes por (píxel de salida × segundo). Solo números, nada del contenido.
model TasaExport {
  filtro   String @id // ninguno | a | b | c
  bytes    Float  @default(0)
  pixSeg   Float  @default(0)
  n        Int    @default(0)
}

// ZIP con contraseña (tipo Takeout) de varios elementos. El servidor no sabe qué contiene: el nombre y la lista van
// cifrados con la clave de metadatos (meta) y la contraseña, sellada con la pública de la bóveda (como las claves de
// los elementos). Mientras se arma, la lista con las claves prestadas vive solo en RAM. Vence a los 7 días.
model Zip {
  id           String    @id @default(uuid())
  meta         String // JSON cifrado { nombre, ids, opciones }
  claveSellada String // JSON {epk, iv, ct}: la contraseña sellada con la pública
  fotos        Int? // lado corto de las fotos (null = original)
  videos       Int? // lado corto de los videos (null = original)
  total        Int       @default(0)
  hechos       Int       @default(0)
  status       String    @default("en_cola") // en_cola | procesando | lista | error
  error        String?
  size         Float     @default(0) // bytes (puede pasar de 2 GB)
  createdAt    DateTime  @default(now())
  readyAt      DateTime?
  expiresAt    DateTime?

  @@index([status, createdAt])
}
