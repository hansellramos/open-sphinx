{
  "name": "boveda",
  "version": "0.1.0",
  "description": "Bóveda privada de videos cifrados (sobre AirCore)",
  "license": "UNLICENSED",
  "type": "module",
  "private": true,
  "scripts": {
    "dev": "concurrently -k -n api,worker,web -c blue,yellow,magenta \"npm:dev:api\" \"npm:dev:worker\" \"npm:dev:web\"",
    "dev:web": "vite",
    "dev:api": "node --watch server/index.ts",
    "dev:worker": "node --watch server/worker.ts",
    "build": "vite build",
    "start": "NODE_ENV=production node server/index.ts",
    "worker": "NODE_ENV=production node server/worker.ts",
    "lint": "eslint",
    "db:migrate": "prisma migrate dev",
    "db:deploy": "prisma migrate deploy",
    "db:generate": "prisma generate",
    "test": "node --test server/tests/*.test.ts"
  },
  "dependencies": {
    "@coreui/coreui": "^5.9.1",
    "@coreui/icons": "^3.1.0",
    "@coreui/icons-vue": "^2.2.0",
    "@coreui/utils": "^2.0.2",
    "@coreui/vue": "^5.10.1",
    "@popperjs/core": "^2.11.8",
    "@prisma/adapter-better-sqlite3": "^7.10.1",
    "@prisma/client": "^7.10.1",
    "@simplewebauthn/server": "^14.0.3",
    "@tus/file-store": "^2.1.1",
    "@tus/server": "^2.4.6",
    "@zip.js/zip.js": "2.23.0",
    "dotenv": "^18.0.9",
    "exifr": "^7.1.3",
    "express": "^5.3.0",
    "express-session": "^1.19.0",
    "hash-wasm": "^4.12.0",
    "hls.js": "^1.7.3",
    "leaflet": "^1.9.4",
    "leaflet.markercluster": "^1.5.3",
    "pinia": "^4.1.0",
    "prisma": "^7.10.1",
    "simplebar-vue": "^2.4.2",
    "tus-js-client": "^4.3.1",
    "vue": "^3.5.44",
    "vue-router": "^5.4.0"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "^6.0.10",
    "autoprefixer": "^10.6.1",
    "concurrently": "^10.0.6",
    "eslint": "^10.13.0",
    "eslint-plugin-vue": "^10.11.1",
    "globals": "^17.13.0",
    "playwright-core": "^1.64.1",
    "postcss": "^8.5.31",
    "sass": "^1.106.1",
    "vite": "^8.3.5"
  }
}
